{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mkdir -p public",
  "outputDirectory": "public",
  "installCommand": "npm ci --omit=dev --ignore-scripts",
  "functions": { "api/*.mjs": { "maxDuration": 120 } },
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "Cache-Control", "value": "no-store" },
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; form-action 'self' https://sb-6186pne7ld4c.vercel.run; frame-ancestors 'none'; base-uri 'none'" }
  ]}]
}

+  })
+  it('keeps supported effort and falls back when switching models', () => {
+    const model = { id: 'example', efforts: ['low', 'medium', 'high'] }
+    expect(availableEffort(model, 'high')).toBe('high')
+    expect(availableEffort(model, 'max')).toBe('medium')
+    expect(availableEffort({ id: 'example', efforts: ['low'] }, 'max')).toBe('low')

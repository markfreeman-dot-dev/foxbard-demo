+
+export interface ModelChoice { id: string; efforts: string[] }
+export interface ModelOptions { model: string; effort: string }
+
+export function requestText(text: string, options: ModelOptions): string {
+  const suffix = `\n<!--foxbard-options:${JSON.stringify(options)}-->`
+  return text.slice(0, 512 - suffix.length) + suffix
+}
+
+export function availableEffort(model: ModelChoice, preferred: string): string {
+  return model.efforts.includes(preferred) ? preferred : model.efforts.includes('medium') ? 'medium' : model.efforts[0]
+}

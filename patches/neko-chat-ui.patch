+export interface HermesQuestion {
+  id: string
+  kind: 'approval' | 'clarify'
+  choices: string[]
+}
+
+export function questionOf(text: string): HermesQuestion | null {
+  const match = text.match(/<!--hermes-question:(\{.*\})-->$/s)
+  if (!match) return null
+  try {
+    const value: unknown = JSON.parse(match[1])
+    if (!value || typeof value !== 'object') return null
+    const q = value as Partial<HermesQuestion>
+    if (typeof q.id !== 'string' || q.id.length > 160 || !['approval', 'clarify'].includes(q.kind ?? '')) return null
+    if (!Array.isArray(q.choices) || q.choices.length > 6 || !q.choices.every((c) => typeof c === 'string')) return null
+    return q as HermesQuestion
+  } catch {
+    return null
+  }
+}
+
+export const visibleText = (text: string) => text.replace(/\n?<!--hermes-(?:question|answer):\{.*\}-->$/s, '')
+
+export function answerText(text: string, id: string, choice?: number): string {
+  const suffix = `\n<!--hermes-answer:${JSON.stringify({ id, ...(choice === undefined ? {} : { choice }) })}-->`
+  return text.slice(0, 512 - suffix.length) + suffix
+}
+
+export function pendingQuestion(lines: { name: string; content: string }[]): HermesQuestion | null {
+  let pending: HermesQuestion | null = null
+  for (const line of lines) {
+    if (line.name !== 'Hermes') continue
+    const question = questionOf(line.content)
+    if (question) pending = question
+    else if (line.content === 'Response sent to Hermes.' || line.content.startsWith('Stopped the active request.') || line.content.startsWith('Started a new conversation.')) pending = null
+  }
+  return pending
+}

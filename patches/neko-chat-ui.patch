+import { describe, expect, it } from 'vitest'
+import { answerText, pendingQuestion, questionOf, visibleText } from './hermes'
+
+const question = { id: 'question-1', kind: 'clarify', choices: ['Python', 'TypeScript'] }
+const card = `Choose an option.\n<!--hermes-question:${JSON.stringify(question)}-->`
+
+describe('Hermes chat answers', () => {
+  it('reads a question and keeps metadata out of the displayed text', () => {
+    expect(questionOf(card)).toEqual(question)
+    expect(visibleText(card)).toBe('Choose an option.')
+  })
+  it('binds a selected choice to its question', () => {
+    const answer = answerText('Python', question.id, 0)
+    expect(answer).toContain('"choice":0')
+    expect(answer).toContain('"id":"question-1"')
+    expect(visibleText(answer)).toBe('Python')
+  })
+  it('accepts a custom answer within the transport limit', () => {
+    const answer = answerText('x'.repeat(512), question.id)
+    expect(answer.length).toBeLessThanOrEqual(512)
+    expect(answer).not.toContain('"choice"')
+  })
+  it('ignores malformed question metadata', () => {
+    expect(questionOf('<!--hermes-question:{oops}-->')).toBeNull()
+    expect(questionOf('<!--hermes-question:{"id":"a","choices":"bad"}-->')).toBeNull()
+  })
+  it('disables answered questions and selects the newest question', () => {
+    const lines = [{ name: 'Hermes', content: card }]
+    expect(pendingQuestion(lines)?.id).toBe(question.id)
+    lines.push({ name: 'Hermes', content: 'Response sent to Hermes.' })
+    expect(pendingQuestion(lines)).toBeNull()
+    lines.push({ name: 'Mark', content: card })
+    expect(pendingQuestion(lines)).toBeNull()
+  })
+})
